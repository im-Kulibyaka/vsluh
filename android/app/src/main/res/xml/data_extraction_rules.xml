<?xml version="1.0" encoding="utf-8"?>
<!-- Не переносить данные WebView (GitHub-токен «Шоу») ни в облачный бэкап, ни на новый телефон. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sizer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/square_sizer" />

    <ImageView
        android:id="@+id/art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignBottom="@id/sizer"
        android:layout_alignLeft="@id/sizer"
        android:layout_alignRight="@id/sizer"
        android:layout_alignTop="@id/sizer"
        android:background="@drawable/widget_shape"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/art_teal_eyes" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@id/sizer"
        android:layout_alignRight="@id/sizer"
        android:layout_alignTop="@id/sizer"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/flame"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/flame_on" />

            <TextView
                android:id="@+id/num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="1437"
                android:textColor="#FFA00F"
                android:textSize="36sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Last chance!"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <Chronometer
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/nunito_extrabold"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>
